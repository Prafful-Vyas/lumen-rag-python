# --- Core infra ---
MONGO_URI=mongodb://127.0.0.1:27017/lumen
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-bytes
PORT=8000

# --- AI providers ---
# Leave OPENAI_API_KEY empty to run fully offline on mock providers (deterministic fake
# embeddings and answers, zero cost). Setting it switches every AI adapter to OpenAI.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024
COMPLETION_MODEL=gpt-4o-mini
CONTEXTUAL_HEADER_MODEL=gpt-4o-mini

# --- Backends (strategy pattern) ---
# local = numpy brute-force cosine + Mongo $text; atlas = $vectorSearch / $search on MongoDB Atlas
VECTOR_BACKEND=local
# local = files under STORAGE_ROOT; s3 = AWS S3 (or MinIO via AWS_ENDPOINT_URL)
STORAGE_BACKEND=local
STORAGE_ROOT=storage
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_ENDPOINT_URL=

# --- Retrieval / generation tuning ---
VECTOR_CANDIDATE_LIMIT=40
LEXICAL_CANDIDATE_LIMIT=40
RRF_K=60
RERANK_TOP_K=8
CONTEXT_TOKEN_BUDGET=6000
REFUSAL_SCORE_THRESHOLD=0.15
NEAR_DUPLICATE_COSINE_THRESHOLD=0.95

# --- Cost control and limits ---
WORKSPACE_DEFAULT_MONTHLY_CAP_USD=50
QUERY_RATE_LIMIT_PER_MINUTE=30

# --- OCR (optional; tesseract on PATH is found automatically) ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- UI ---
LUMEN_API_URL=http://localhost:8000
